# PR-Triage Agent runtime config. Copy to .env and fill in.
# Every key here is documented; no secret values are committed.

# Fine-grained GitHub token. Scopes: read PRs/diff/CI + write PR comments/labels
# on TARGET_REPO ONLY. Judges: create a fresh token for a sandbox repo.
GITHUB_TOKEN=

# Target repo the agent may triage (everything else is refused in code)
TARGET_REPO=Meet-4/agentware-sandbox

# OpenAI-compatible LLM endpoint. OPTIONAL — leave LLM_API_KEY empty to run
# in heuristic-only mode (static triage still produces the full review).
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_API_KEY=
LLM_MODEL=

# Autonomy level: L0 = comments/labels only (default, safest)
#                 L1 = additionally push whitelisted trivial fixes
AUTONOMY_LEVEL=L0

# Safety caps per run (hard limits, enforced in code)
MAX_LLM_CALLS_PER_RUN=25
MAX_RUN_MINUTES=10
MAX_COST_USD_PER_RUN=0.50

# Webhook mode (python -m agentkit.trigger serve) — optional but recommended:
# shared secret for HMAC-SHA256 verification of incoming GitHub webhooks
WEBHOOK_SECRET=

